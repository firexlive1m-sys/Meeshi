# Razorpay API Configuration
# Get these keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Gemini API Key (Server-Side Only)
GEMINI_API_KEY=

# EmailJS Configuration for OTP
EMAILJS_SERVICE_ID=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Firebase Admin SDK Configuration (Server-Side Only for OTP)
# You can generate a private key file from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

